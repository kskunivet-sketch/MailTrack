# ========================================
# MailTrack Pro - Environment Variables
# ========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git!

# Firebase Configuration
# Get these from Firebase Console → Project Settings → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Drive Backup JSON URLs (Failover when Firestore quota exceeded)
# Format: https://drive.google.com/file/d/YOUR_FILE_ID/view
NEXT_PUBLIC_BACKUP_JSON_URL=https://drive.google.com/file/d/YOUR_MASUK_FILE_ID/view
NEXT_PUBLIC_BACKUP_JSON_URL_KELUAR=https://drive.google.com/file/d/YOUR_KELUAR_FILE_ID/view
